import atletas.*
import disciplinas.*
import elementos.*



describe "Test de escenarios propuestos en el dominio para atletas" {
    test "el presupuesto propio de victoria al inicio es de 40" {
        assert.equals(40, victoria.presupuestoPropio())
    }
    test "Victoria se quiere parecer a Pareto (que mide 150 cms), se hace pequeña, practica judo y por lo tanto necesita un traje de judo. Además, tiene 4 entrenadores. Debe dar 8020" {
        victoria.altura(150)
        victoria.cambiarDisciplina(judo)
        victoria.cambiarElemento(trajeDeJudo)
        victoria.cambiarCantidadDeEntrenadores(4)
        assert.equals(40+160*3+50*150, victoria.presupuesto())
    }
    test "Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, necesita una raqueta y tiene dos entrenadores. Debe dar 2435" {
        victoria.altura(220)
        victoria.cambiarDisciplina(tenis)
        victoria.cambiarElemento(raqueta)
        victoria.cambiarCantidadDeEntrenadores(2)
        assert.equals(20+200+3*5+100*22, victoria.presupuesto())
    }
}